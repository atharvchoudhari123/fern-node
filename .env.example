# Comma-separated domains to block in proxy destination checks.
# Include hostnames only (no scheme, path, or port).
# Example: example.org blocks example.org and, when enabled, its subdomains.
PROXY_BLOCKED_DOMAINS=example.org,blocked.test,social.example

# When true, a blocked domain also blocks all of its subdomains.
PROXY_BLOCK_SUBDOMAINS=true
